# SupportDesk AI - configuration example (placeholder values only, never commit real keys).
#
# .NET does not read .env files automatically. Use ONE of these ways to provide the values:
#   1) User secrets (recommended for development), from the SupportDeskAI project folder:
#        dotnet user-secrets set "GROQ_API_KEY" "your-groq-api-key-here"
#   2) Environment variables in your terminal before "dotnet run" (PowerShell):
#        $env:GROQ_API_KEY = "your-groq-api-key-here"
#
# Nested settings use a double underscore in environment variables (Ai:Provider -> Ai__Provider).

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# "Groq" = real AI, "Mock" = built-in fake AI that needs no key
Ai__Provider=Groq

# Seconds before an AI call is cancelled and the API returns 504
Ai__TimeoutSeconds=30

# Groq model name
Groq__Model=openai/gpt-oss-120b
