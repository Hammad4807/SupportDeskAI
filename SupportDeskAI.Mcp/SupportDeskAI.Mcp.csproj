<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SupportDeskAI\SupportDeskAI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same id as the API project, so both read the same user-secrets file (GROQ_API_KEY). -->
    <UserSecretsId>5280523e-7b8f-4925-85c4-af9d6cc6d0b3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy appsettings.json next to the .exe: the MCP client starts the server from any folder,
         so the settings are read from the output folder, not from the current directory. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
