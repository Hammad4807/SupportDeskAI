{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=supportdesk.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Ai": {
    "Provider": "Groq",
    "TimeoutSeconds": 30
  },
  "Groq": {
    "Model": "openai/gpt-oss-120b",
    "MaxCompletionTokens": 1024
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
